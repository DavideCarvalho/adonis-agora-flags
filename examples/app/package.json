{
  "name": "flags-example-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "node bin/server.js",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#flags/*": "./app/flags/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#generated/*": "./.adonisjs/server/*.js"
  },
  "dependencies": {
    "@adonis-agora/flags": "file:.packs/flags.tgz",
    "@adonisjs/auth": "10.1.0",
    "@adonisjs/bouncer": "4.0.1",
    "@adonisjs/core": "7.6.0",
    "@adonisjs/lucid": "22.4.2",
    "@adonisjs/session": "8.3.0",
    "@adonisjs/shield": "9.0.0",
    "@vinejs/vine": "4.4.0",
    "better-sqlite3": "13.0.3",
    "edge.js": "6.5.1",
    "luxon": "3.7.2",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@adonisjs/assembler": "8.6.0",
    "@adonisjs/tsconfig": "2.0.0",
    "@japa/api-client": "3.2.1",
    "@japa/assert": "4.2.0",
    "@japa/plugin-adonisjs": "5.2.0",
    "@japa/runner": "5.4.0",
    "@poppinss/ts-exec": "1.5.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/luxon": "3.7.6",
    "@types/node": "25.9.9",
    "hot-hook": "1.0.0",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "youch": "4.1.1"
  }
}
